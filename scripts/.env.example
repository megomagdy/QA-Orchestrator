# Credentials for the bug-reporter tracker adapter.
#
# Copy this file to `.env` (same folder, or your project folder — the project
# folder wins if both exist) and fill in the variables YOUR adapter requires.
# Each adapter declares its required variables in its `requiredEnv` list —
# open scripts/adapters/<your-tracker>.js to see which ones you need.
#
# NEVER commit or share the real .env file. Share only this example.

# Example for a generic token-based tracker adapter:
TRACKER_API_TOKEN=

# Examples of variables other trackers typically need (rename per adapter):
# ATLASSIAN_EMAIL=you@company.com        # Jira Cloud
# ATLASSIAN_API_TOKEN=                   # Jira Cloud
# AZURE_DEVOPS_PAT=                      # Azure DevOps personal access token
# GITHUB_TOKEN=                          # GitHub Issues
